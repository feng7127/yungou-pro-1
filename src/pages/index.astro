  </head>
  <body>
    <DesktopHome />
    <MobileHome />
    <ArticleStrip />
    <footer class="site-footer">
      <b>盈云购系统</b>
      <span>源码官网 / 前端展示 / 咨询转化</span>
    </footer>
    <script>
      const copyButtons = document.querySelectorAll<HTMLElement>("[data-copy]");
      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const value = button.dataset.copy || "";
          const label = button.dataset.copyLabel || "内容";
          const feedback = document.getElementById(button.dataset.feedback || "");
          try {
            await navigator.clipboard.writeText(value);
            if (feedback) feedback.textContent = `${label}已复制：${value}`;
          } catch {
            if (feedback) feedback.textContent = `${label}：${value}`;
          }
        });
      });

      const desktopNav = document.querySelector<HTMLElement>(".desktop-home .nav");
      const updateDesktopNav = () => desktopNav?.classList.toggle("is-sticky", window.scrollY >= 18);
      updateDesktopNav();
      window.addEventListener("scroll", updateDesktopNav, { passive: true });

      const packageCards = document.querySelectorAll<HTMLElement>("[data-package-card]");
      const clearFeaturedPackage = () => packageCards.forEach((card) => card.classList.remove("featured"));
      packageCards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          clearFeaturedPackage();
          card.classList.add("featured");
        });
        card.addEventListener("mouseleave", () => card.classList.remove("featured"));
        card.addEventListener("focusin", () => {
          clearFeaturedPackage();
          card.classList.add("featured");
        });
        card.addEventListener("focusout", (event) => {
          if (!(event.relatedTarget instanceof Node) || !card.contains(event.relatedTarget)) {
            card.classList.remove("featured");
          }
        });
      });

      const sceneLists = document.querySelectorAll<HTMLElement>("[data-scene-list]");
      sceneLists.forEach((sceneList) => {
        const sceneCards = [
          ...sceneList.querySelectorAll<HTMLElement>("[data-scene-card]"),
        ];
        if (!sceneCards.length) return;
        const DEFAULT_SCENE = 3;
        const clearActiveScene = () =>
          sceneCards.forEach((card) => card.classList.remove("active"));
        const restoreDefaultScene = () =>
          sceneCards.forEach((card, index) =>
            card.classList.toggle("active", index === DEFAULT_SCENE),
          );
        sceneCards.forEach((card) => {
          card.addEventListener("mouseenter", () => {
            clearActiveScene();
            card.classList.add("active");
          });
          card.addEventListener("focusin", () => {
            clearActiveScene();
            card.classList.add("active");
          });
          card.addEventListener("click", () => {
            clearActiveScene();
            card.classList.add("active");
          });
        });
        sceneList.addEventListener("mouseleave", restoreDefaultScene);
        sceneList.addEventListener("focusout", (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !sceneList.contains(event.relatedTarget)
          ) {
            restoreDefaultScene();
          }
        });
      });

      const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
      const menuDialog = document.querySelector<HTMLElement>("[data-menu-dialog]");
      const menuClose = document.querySelector<HTMLButtonElement>("[data-menu-close]");
      const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
      let lastFocusedElement: HTMLElement | null = null;
      const closeMenu = () => {
        if (!menuDialog) return;
        menuDialog.hidden = true;
        menuButton?.setAttribute("aria-expanded", "false");
        lastFocusedElement?.focus();
      };
      const openMenu = () => {
        if (!menuDialog) return;
        lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        menuDialog.hidden = false;
        menuButton?.setAttribute("aria-expanded", "true");
        requestAnimationFrame(() => menuClose?.focus());
      };
      menuButton?.addEventListener("click", openMenu);
      menuClose?.addEventListener("click", closeMenu);
      menuLinks.forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (!menuDialog || menuDialog.hidden) return;
        if (event.key === "Escape") { event.preventDefault(); closeMenu(); return; }
        if (event.key !== "Tab") return;
        const focusable = [...menuDialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme:light; font-family:"PingFang SC","Microsoft YaHei",ui-sans-serif,system-ui,sans-serif; scroll-behavior:smooth; background:#f3f8ff; }
  body { margin:0; background:#f3f8ff; }
  .mobile-home { display:none; }

  @media (prefers-reduced-motion:reduce) {
    :root { scroll-behavior:auto; }
  }

  .site-footer {
    display:flex;
    justify-content:space-between;
    gap:24px;
    width:min(calc(100% - 160px),1440px);
    margin-inline:auto;
    padding:40px 0 30px;
    color:#7b879d;
    font-size:14px;
  }
  .site-footer b { color:#151a24; font-size:16px; }

  @media (max-width:1180px) {
    .site-footer { width:min(calc(100% - 80px),1080px); }
  }

  @media (max-width:768px) {
    .desktop-home { display:none; }
    .mobile-home { display:block; }
    .site-footer {
      flex-direction:column;
      gap:5px;
      width:calc(100% - 32px);
      padding:25px 0 calc(15px + 82px + env(safe-area-inset-bottom));
      color:#7b8ba3;
      font-size:11px;
    }
    .site-footer b { color:#10213b; font-size:13px; }
  }
</style>
