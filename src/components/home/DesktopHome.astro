---
import {
  addOnServices,
  assets,
  demos,
  faqs,
  features,
  growthCards,
  packages,
  scenes,
} from "../../data/home";
---

<div class="desktop-home" data-home-variant="desktop">
  <div class="nav-layer">
    <nav class="nav" aria-label="主导航">
      <a class="brand" href="#pc-top" aria-label="盈云购系统首页"
        ><img src={assets.brand.src} alt="" /><span>盈云购系统</span></a
      >
      <div class="nav-links">
        <a href="#pc-top">首页</a><a href="#pc-features">功能展示</a><a
          href="#pc-demo">演示版本</a
        ><a href="#pc-packages">合作方案</a><a href="#pc-preview">页面预览</a><a
          href="#pc-contact">联系我们</a
        >
      </div>
      <a class="nav-cta" href="#pc-packages">了解合作</a>
    </nav>
  </div>
  <header class="hero" id="pc-top">
    <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
    <div class="nav-slot" aria-hidden="true"></div>
    <section class="hero-content">
      <div class="hero-copy">
        <p class="eyebrow"><i></i>前端官网 / 移动端页面 / 咨询转化</p>
        <h1>1元云购系统源码海外版</h1>
        <p class="lede">
          展示商品夺宝、开奖揭晓、购物车页面、活动营销、多语言视觉和移动端界面效果。
        </p>
        <div class="hero-actions">
          <a class="button secondary" href="#pc-demo">查看演示</a><a
            class="button secondary"
            href="#pc-packages">了解合作</a
          ><a class="button ghost" href="#pc-contact">联系客服</a>
        </div>
        <div class="metrics" aria-label="产品指标">
          <div><strong>50+</strong><span>核心页面场景</span></div><div>
            <strong>4</strong><span>演示主题版本</span>
          </div><div><strong>静态</strong><span>前端交互展示</span></div>
        </div>
      </div>
      <div class="hero-visual" aria-label="移动端页面预览">
        <span class="orbit orbit-a">多语言</span><span class="orbit orbit-b"
          >报价转化</span
        ><div class="phone">
          <img
            src={assets.appHome.src}
            alt="盈云购移动端页面预览"
            loading="eager"
          />
        </div>
      </div>
    </section>
  </header>

  <main>
    <section class="section" id="pc-features">
      <div class="heading">
        <span>核心模块</span><h2>核心页面模块，一屏建立产品认知</h2><p>
          延续 App
          首页的圆形入口语言，让访客快速理解页面范围、活动玩法和移动端效果。
        </p>
      </div>
      <div class="feature-grid">
        {
          features.map((feature) => (
            <article class="feature">
              <>
                <img src={feature.icon.src} alt="" loading="lazy" />
                <div>
                  <>
                    <h3>{feature.name}</h3>
                    <p>{feature.description}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section tinted" id="pc-demo">
      <div class="heading">
        <span>演示与报价</span><h2>先看演示，再选适合的报价方案</h2><p>
          四个主题只说明视觉方向和页面效果；价格与增值服务在下方独立呈现。
        </p>
      </div>
      <div class="demo-grid">
        {
          demos.map((demo) => (
            <article class="demo">
              <>
                <div class="demo-title">
                  <>
                    <h3>{demo.name}</h3>
                    <b>{demo.badge}</b>
                  </>
                </div>
                <div class="demo-body">
                  <>
                    <img
                      src={demo.image.src}
                      alt={`${demo.name}页面预览`}
                      loading="lazy"
                    />
                    <div>
                      <>
                        <p>{demo.description}</p>
                        <div class="demo-actions">
                          <>
                            <a href="#pc-contact">咨询演示</a>
                            <a href="#pc-contact">咨询价格</a>
                          </>
                        </div>
                      </>
                    </div>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="pc-packages">
      <div class="heading">
        <span>合作方案</span><h2>有推广团队，我们帮助免费部署</h2><p>
          标准系统不收部署费用，只需购买我们的服务器；额外定制单独计费，技术团队维护运营按项目实际盈利的
          20% 收费。
        </p>
      </div>
      <div class="package-grid">
        {
          packages.map((item) => (
            <article class="package" data-package-card>
              <>
                <span>{item.name}</span>
                <strong>{item.price}</strong>
                <small>{item.description}</small>
                <ul>
                  {item.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <a href="#pc-contact">咨询合作</a>
              </>
            </article>
          ))
        }
      </div>
      <div class="add-ons">
        {
          addOnServices.map(([name, price]) => (
            <article>
              <>
                <strong>{name}</strong>
                <span>{price}</span>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section preview" id="pc-preview">
      <div class="heading">
        <span>页面预览</span><h2>核心页面场景，一眼看清</h2><p>
          把首页、商品、活动和咨询转化整理成可视化卡片，减少解释成本，提升方案可信度。
        </p>
      </div>
      <div class="preview-grid">
        <div class="scene-list">
          <img
            class="scene-image"
            src={assets.scenePreview.src}
            alt="页面场景组合预览"
            loading="lazy"
          />{
            scenes.map(([icon, name, description], index) => (
              <article class:list={["scene", { active: index === 3 }]}>
                <>
                  <img src={icon.src} alt="" loading="lazy" />
                  <div>
                    <>
                      <strong>{name}</strong>
                      <span>{description}</span>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div><aside class="dashboard">
          <div><span>运营展示能力</span><b>静态可落地</b></div><img
            src={assets.dashboardPreview.src}
            alt="后台运营截图预览"
            loading="lazy"
          /><div class="stats">
            <span><b>128</b>商品展示卡</span><span><b>36%</b>状态统计卡</span
            ><span><b>¥6800</b>价格信息卡</span>
          </div><a href="#pc-contact">咨询客服</a>
        </aside>
      </div>
    </section>

    <section class="section faq-section" id="pc-faq">
      <div class="heading">
        <span>常见问题</span><h2>关于云购系统源码，你可能想问</h2><p>
          页面范围、多语言、价格与定制方式，常见疑问一次说清。
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section" id="pc-growth">
      <div class="heading">
        <span>咨询转化</span><h2>从需求确认到报价咨询，路径清晰</h2><p>
          把营销展示、流程说明、合规提示和客服入口放在同一收束区，方便访客直接行动。
        </p>
      </div>
      <div class="growth-grid">
        {
          growthCards.map(([name, description, icon]) => (
            <article>
              <>
                <img src={icon.src} alt="" loading="lazy" />
                <strong>{name}</strong>
                <span>{description}</span>
              </>
            </article>
          ))
        }
      </div>
      <div class="conversion-row">
        <div class="conversion-steps">
          {
            ["需求确认", "页面设计", "页面制作", "预览确认"].map(
              (step, index) => (
                <article>
                  <>
                    <i>{index + 1}</i>
                    <strong>{step}</strong>
                  </>
                </article>
              ),
            )
          }
        </div>
        <div class="notice">
          <img src={assets.complianceShield.src} alt="" loading="lazy" /><p>
            页面内容仅用于产品展示和方案介绍。实际业务运营前，请自行确认当地关于抽奖、积分、营销活动、数据隐私等法规要求。
          </p>
        </div>
      </div>
      <section
        class="contact"
        id="pc-contact"
        aria-labelledby="pc-contact-title"
      >
        <div class="contact-copy">
          <h2 id="pc-contact-title">准备上线你的1元云购网站？</h2>
        </div><div class="contact-actions">
          <div class="contact-buttons">
            <a
              class="button contact-telegram"
              href="https://t.me/yyg88_bot"
              target="_blank"
              rel="noopener noreferrer"
              ><img src={assets.footerTelegram.src} alt="" />@yyg88_bot</a
            ><button
              class="button contact-qq"
              type="button"
              data-copy="191064227"
              data-copy-label="QQ号"
              data-feedback="pc-copy-feedback"
              ><img src={assets.footerQQ.src} alt="" />复制QQ</button
            ><a class="button contact-features" href="#pc-features"
              ><img src={assets.footerFeatures.src} alt="" />获取功能清单</a
            ><a class="button contact-pricing" href="#pc-packages"
              ><img src={assets.footerPricing.src} alt="" />了解合作模式</a>
          </div><span
            class="copy-feedback"
            id="pc-copy-feedback"
            aria-live="polite"></span>
        </div>
      </section>
    </section>
  </main>
  <footer><b>盈云购系统</b><span>源码官网 / 前端展示 / 咨询转化</span></footer>
</div>

<style>
  .desktop-home {
    --blue: #0b74ff;
    --cyan: #38bdf8;
    --line: #d9e8ff;
    --ink: #151a24;
    --muted: #6b7a90;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #eaf4ff 0, #fff 54%);
    color: var(--ink);
  }
  .desktop-home :global(*) {
    box-sizing: border-box;
  }
  .desktop-home :global(h1),
  .desktop-home :global(h2),
  .desktop-home :global(h3),
  .desktop-home :global(p) {
    margin: 0;
  }
  .desktop-home :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .desktop-home :global(button) {
    font: inherit;
  }
  .desktop-home :global(:where(a, button):focus-visible) {
    outline: 3px solid var(--cyan);
    outline-offset: 4px;
  }
  .hero {
    min-height: 680px;
    position: relative;
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 82% 20%,
        rgba(93, 216, 255, 0.72),
        transparent 27rem
      ),
      linear-gradient(180deg, #0b74ff 0%, #0062ff 60%, #eaf4ff 100%);
  }
  .hero::after {
    position: absolute;
    content: "";
    width: 680px;
    height: 680px;
    right: -190px;
    bottom: -330px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(26px);
    background: rgba(255, 255, 255, 0.12);
  }
  .glow-one {
    width: 480px;
    height: 480px;
    right: 115px;
    top: 28px;
  }
  .glow-two {
    width: 220px;
    height: 220px;
    right: 145px;
    top: 270px;
  }
  .nav,
  .hero-content,
  .section,
  .desktop-home footer {
    width: min(calc(100% - 160px), 1440px);
    margin-inline: auto;
  }
  .nav-layer {
    position: absolute;
    z-index: 10;
    inset: 0 0 auto;
    height: 0;
  }
  .nav-slot {
    height: 72px;
  }
  .nav {
    position: absolute;
    top: 34px;
    left: 50%;
    height: 72px;
    padding: 0 26px;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.76);
    color: #14233b;
    box-shadow: 0 18px 36px rgba(7, 83, 195, 0.16);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
  }
  .nav.is-sticky {
    position: fixed;
    top: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
  }
  .brand img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .brand span {
    font-size: 18px;
  }
  .nav-links {
    display: flex;
    gap: 27px;
    color: #445672;
    font-size: 15px;
    font-weight: 800;
  }
  .nav-links a:hover,
  .nav-links .active {
    color: var(--blue);
  }
  .nav-cta,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    cursor: pointer;
    font-weight: 800;
  }
  .nav-cta {
    border: none;
  }
  .desktop-home .nav-cta {
    min-width: 132px;
    height: 44px;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(180deg, #19c8ff, #0877ff);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    min-height: 574px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 92px;
  }
  .hero-copy {
    width: 620px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 14px;
  }
  .eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 6px rgba(56, 189, 248, 0.18);
  }
  h1 {
    max-width: 620px;
    margin-top: 18px !important;
    font-size: 52px;
    line-height: 1.18;
    letter-spacing: -0.04em;
  }
  .lede {
    max-width: 455px;
    margin-top: 24px !important;
    font-size: 17px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 38px;
  }
  .button {
    min-height: 54px;
    padding: 0 27px;
    border-radius: 999px;
  }
  .hero-actions .primary {
    color: var(--blue);
    background: #fff;
  }
  .hero-actions .secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.12);
  }
  .hero-actions .ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.14);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 36px;
    max-width: 480px;
  }
  .metrics div {
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
  }
  .metrics strong,
  .metrics span {
    display: block;
  }
  .metrics strong {
    font-size: 23px;
  }
  .metrics span {
    margin-top: 3px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.78);
  }
  .hero-visual {
    position: relative;
    width: 400px;
    height: 470px;
    align-self: end;
  }
  .phone {
    position: absolute;
    right: 42px;
    bottom: 0;
    width: 242px;
    overflow: hidden;
    border: 8px solid #14233b;
    border-radius: 34px;
    background: #14233b;
    box-shadow: 0 28px 56px rgba(0, 48, 120, 0.34);
  }
  .phone img {
    display: block;
    width: 100%;
    border-radius: 20px 20px 0 0;
  }
  .orbit {
    position: absolute;
    z-index: 1;
    padding: 11px 15px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 28px rgba(0, 64, 157, 0.18);
    backdrop-filter: blur(10px);
    font-size: 13px;
    font-weight: 800;
  }
  .orbit-a {
    top: 112px;
    left: 10px;
  }
  .orbit-b {
    right: 0;
    bottom: 126px;
  }
  .section {
    padding: 84px 0;
  }
  .heading {
    max-width: 760px;
    margin-bottom: 36px;
  }
  .heading > span {
    display: inline-flex;
    padding: 5px 12px;
    border-radius: 999px;
    color: var(--blue);
    background: #eaf4ff;
    font-size: 13px;
    font-weight: 800;
  }
  .heading h2 {
    margin-top: 14px !important;
    font-size: 40px;
    line-height: 1.16;
    letter-spacing: -0.035em;
  }
  .heading p {
    margin-top: 12px !important;
    color: #64748b;
    font-size: 17px;
    line-height: 1.5;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
  }
  .feature {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 13px;
    align-items: center;
    min-height: 110px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 10px 24px rgba(0, 87, 230, 0.06);
  }
  .feature img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }
  .feature h3 {
    font-size: 16px;
  }
  .feature p {
    margin-top: 5px !important;
    color: #7b879d;
    font-size: 12px;
    line-height: 1.3;
  }
  .tinted {
    position: relative;
  }
  .tinted::before {
    position: absolute;
    z-index: 0;
    inset: 185px -42px auto;
    height: 1300px;
    border-radius: 38px;
    content: "";
    background: linear-gradient(180deg, #edf6ff, rgba(237, 246, 255, 0));
  }
  .tinted > * {
    position: relative;
    z-index: 1;
  }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  .demo {
    position: relative;
    overflow: hidden;
    padding: 22px 24px 24px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 14px 34px rgba(0, 87, 230, 0.06);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }
  .demo:hover {
    border-color: #8abfff;
    box-shadow: 0 24px 48px rgba(0, 87, 230, 0.14);
    transform: translateY(-6px);
  }
  .demo-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .demo-title h3 {
    font-size: 21px;
  }
  .demo-title b {
    padding: 5px 11px;
    border-radius: 999px;
    color: var(--blue);
    background: #eaf4ff;
    font-size: 12px;
  }
  .demo-body img {
    width: 100%;
    border-radius: 14px;
    object-fit: contain;
    background: #eaf4ff;
  }
  .demo-media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 11 / 6;
    place-items: center;
    padding: 0;
    margin-top: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #eaf4ff;
    cursor: zoom-in;
    isolation: isolate;
  }
  .demo-media.portrait {
    height: 560px;
    aspect-ratio: auto;
  }
  .demo-media::after {
    position: absolute;
    z-index: 3;
    top: -35%;
    left: -55%;
    width: 34%;
    height: 170%;
    content: "";
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.5),
      transparent
    );
    opacity: 0;
    pointer-events: none;
    transform: rotate(16deg);
  }
  .demo:hover .demo-media::after {
    animation: demo-shine 0.9s ease;
  }
  .demo-backdrop {
    position: absolute;
    z-index: 0;
    inset: -18px;
    width: calc(100% + 36px);
    height: calc(100% + 36px);
    object-fit: cover;
    opacity: 0.24;
    filter: blur(18px) saturate(1.18);
    transform: scale(1.08);
    transition: transform 0.6s ease;
  }
  .demo-preview-image {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    padding: 14px;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 14px 22px rgba(10, 55, 120, 0.2));
    transition: transform 0.55s cubic-bezier(0.2, 0.75, 0.25, 1);
  }
  .demo:hover .demo-backdrop {
