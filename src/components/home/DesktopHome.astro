---
import {
  addOnServices,
  assets,
  demos,
  features,
  growthCards,
  packages,
  scenes,
} from "../../data/home";
---

<div class="desktop-home" data-home-variant="desktop">
  <div class="nav-layer">
    <nav class="nav" aria-label="主导航">
      <a class="brand" href="#pc-top" aria-label="盈云购系统首页"><img src={assets.brandIcon.src} alt="" /><span>盈云购系统</span></a>
      <div class="nav-links">
        <a class="active" href="#pc-top">首页</a><a href="#pc-features">功能展示</a><a href="#pc-demo">演示版本</a><a href="#pc-packages">价格套餐</a><a href="#pc-preview">页面预览</a><a href="#pc-contact">联系我们</a>
      </div>
      <a class="nav-cta" href="#pc-packages">获取报价</a>
    </nav>
  </div>
  <header class="hero" id="pc-top">
    <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
    <div class="nav-slot" aria-hidden="true"></div>
    <section class="hero-content">
      <div class="hero-copy">
        <p class="eyebrow"><i></i>前端官网 / 移动端页面 / 咨询转化</p>
        <h1>海外云购系统源码展示官网</h1>
        <p class="lede">展示商品夺宝、开奖揭晓、购物车页面、活动营销、多语言视觉和移动端界面效果，适合投放推广、产品介绍和对外演示。</p>
        <div class="hero-actions"><a class="button primary" href="#pc-demo">查看演示</a><a class="button secondary" href="#pc-packages">获取报价</a><button class="button ghost" type="button" data-copy="YunGouPro" data-feedback="pc-copy-feedback">联系客服</button></div>
        <div class="metrics" aria-label="产品指标"><div><strong>10+</strong><span>核心页面场景</span></div><div><strong>4</strong><span>演示主题版本</span></div><div><strong>静态</strong><span>前端交互展示</span></div></div>
      </div>
      <div class="hero-visual" aria-label="移动端页面预览"><span class="orbit orbit-a">多语言</span><span class="orbit orbit-b">报价转化</span><div class="phone"><img src={assets.appHome.src} alt="盈云购移动端页面预览" loading="eager" /></div></div>
    </section>
  </header>

  <main>
    <section class="section" id="pc-features">
      <div class="heading"><span>核心模块</span><h2>核心页面模块，一屏建立产品认知</h2><p>延续 App 首页的圆形入口语言，让访客快速理解页面范围、活动玩法和移动端效果。</p></div>
      <div class="feature-grid">{features.map((feature) => <article class="feature"><img src={feature.icon.src} alt="" loading="lazy" /><div><h3>{feature.name}</h3><p>{feature.description}</p></div></article>)}</div>
    </section>

    <section class="section tinted" id="pc-demo">
      <div class="heading"><span>演示与报价</span><h2>先看演示，再选适合的报价方案</h2><p>四个主题只说明视觉方向和页面效果；价格与增值服务在下方独立呈现。</p></div>
      <div class="demo-grid">{demos.map((demo) => <article class="demo"><div class="demo-title"><h3>{demo.name}</h3><b>{demo.badge}</b></div><div class="demo-body"><img src={demo.image.src} alt={`${demo.name}页面预览`} loading="lazy" /><div><p>{demo.description}</p><div class="demo-actions"><a href="#pc-contact">咨询演示</a><a href="#pc-contact">咨询价格</a></div></div></div></article>)}</div>
    </section>

    <section class="section" id="pc-packages">
      <div class="heading"><span>价格套餐</span><h2>页面、主题、文案、适配，按需组合</h2><p>三个标准套餐覆盖从快速展示到品牌化上线的需求，也可按需定制。</p></div>
      <div class="package-grid">{packages.map((item, index) => <article class:list={["package", { featured: index === 1 }]}><span>{item.name}</span><strong>{item.price}</strong><small>{item.usdtPrice}</small><ul>{item.features.map((feature) => <li>{feature}</li>)}</ul><a href="#pc-contact">获取报价</a></article>)}</div>
      <div class="add-ons">{addOnServices.map(([name, price]) => <article><strong>{name}</strong><span>{price}</span></article>)}</div>
    </section>

    <section class="section preview" id="pc-preview">
      <div class="heading"><span>页面预览</span><h2>核心页面场景，一眼看清</h2><p>把首页、商品、活动和咨询转化整理成可视化卡片，减少解释成本，提升方案可信度。</p></div>
      <div class="preview-grid"><div class="scene-list"><img class="scene-image" src={assets.scenePreview.src} alt="页面场景组合预览" loading="lazy" />{scenes.map(([icon, name, description], index) => <article class:list={["scene", { active: index === 3 }]}><img src={icon.src} alt="" loading="lazy" /><div><strong>{name}</strong><span>{description}</span></div></article>)}</div><aside class="dashboard"><div><span>运营展示能力</span><b>静态可落地</b></div><img src={assets.dashboardPreview.src} alt="后台运营截图预览" loading="lazy" /><div class="stats"><span><b>128</b>商品展示卡</span><span><b>36%</b>状态统计卡</span><span><b>¥6800</b>价格信息卡</span></div><a href="#pc-contact">咨询客服</a></aside></div>
    </section>

    <section class="section" id="pc-growth">
      <div class="heading"><span>咨询转化</span><h2>从需求确认到报价咨询，路径清晰</h2><p>把营销展示、流程说明、合规提示和客服入口放在同一收束区，方便访客直接行动。</p></div>
      <div class="growth-grid">{growthCards.map(([name, description, icon]) => <article><img src={icon.src} alt="" loading="lazy" /><strong>{name}</strong><span>{description}</span></article>)}</div>
      <div class="conversion-row">
        <div class="conversion-steps">{["需求确认", "页面设计", "页面制作", "预览确认"].map((step, index) => <article><i>{index + 1}</i><strong>{step}</strong></article>)}</div>
        <div class="notice"><img src={assets.complianceShield.src} alt="" loading="lazy" /><p>页面内容仅用于产品展示和方案介绍。实际业务运营前，请自行确认当地关于抽奖、积分、营销活动、数据隐私等法规要求。</p></div>
      </div>
      <section class="contact" id="pc-contact" aria-labelledby="pc-contact-title"><div class="contact-copy"><h2 id="pc-contact-title">准备上线你的云购展示官网？</h2></div><div class="contact-actions"><div class="contact-buttons"><button class="button contact-telegram" type="button" data-copy="YunGouPro" data-feedback="pc-copy-feedback"><img src={assets.footerTelegram.src} alt="" />Telegram 咨询</button><button class="button contact-wechat" type="button" data-copy="YunGouPro" data-feedback="pc-copy-feedback"><img src={assets.footerWechat.src} alt="" />复制微信</button><a class="button contact-features" href="#pc-features"><img src={assets.footerFeatures.src} alt="" />获取功能清单</a><a class="button contact-pricing" href="#pc-packages"><img src={assets.footerPricing.src} alt="" />获取最新报价</a></div><span class="copy-feedback" id="pc-copy-feedback" aria-live="polite"></span></div></section>
    </section>

  </main>
  <footer><b>盈云购系统</b><span>源码官网 / 前端展示 / 咨询转化</span></footer>
</div>

<style>
  .desktop-home { --blue:#0b74ff; --cyan:#38bdf8; --line:#d9e8ff; --ink:#151a24; --muted:#6b7a90; position:relative; overflow:hidden; background:linear-gradient(180deg,#eaf4ff 0,#fff 54%); color:var(--ink); }
  .desktop-home :global(*) { box-sizing:border-box; } .desktop-home :global(h1), .desktop-home :global(h2), .desktop-home :global(h3), .desktop-home :global(p) { margin:0; } .desktop-home :global(a) { color:inherit; text-decoration:none; } .desktop-home :global(button) { font:inherit; } .desktop-home :global(:where(a,button):focus-visible) { outline:3px solid var(--cyan); outline-offset:4px; }
  .hero { min-height:680px; position:relative; color:#fff; overflow:hidden; background:radial-gradient(circle at 82% 20%,rgba(93,216,255,.72),transparent 27rem),linear-gradient(180deg,#0b74ff 0%,#0062ff 60%,#eaf4ff 100%); } .hero::after { position:absolute; content:""; width:680px; height:680px; right:-190px; bottom:-330px; border-radius:50%; background:rgba(255,255,255,.12); }
  .hero-glow { position:absolute; border-radius:50%; filter:blur(26px); background:rgba(255,255,255,.12); } .glow-one { width:480px; height:480px; right:115px; top:28px; } .glow-two { width:220px; height:220px; right:145px; top:270px; }
  .nav,.hero-content,.section,.desktop-home footer { width:min(calc(100% - 160px),1440px); margin-inline:auto; } .nav-layer { position:absolute; z-index:10; inset:0 0 auto; height:0; } .nav-slot { height:72px; } .nav { position:absolute; top:34px; left:50%; height:72px; padding:0 26px; margin:0; display:flex; align-items:center; justify-content:space-between; border:1px solid rgba(255,255,255,.82); border-radius:30px; background:rgba(255,255,255,.76); color:#14233b; box-shadow:0 18px 36px rgba(7,83,195,.16); backdrop-filter:blur(18px); transform:translateX(-50%); } .nav.is-sticky { position:fixed; top:16px; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:900; } .brand img { width:40px; height:40px; object-fit:contain; } .brand span { font-size:18px; } .nav-links { display:flex; gap:27px; color:#445672; font-size:15px; font-weight:800; } .nav-links a:hover,.nav-links .active { color:var(--blue); } .nav-cta,.button { display:inline-flex; align-items:center; justify-content:center; border:1px solid transparent; cursor:pointer; font-weight:800; } .desktop-home .nav-cta { min-width:132px; height:44px; border-radius:999px; color:#fff; background:linear-gradient(180deg,#19c8ff,#0877ff); }
  .hero-content { position:relative; z-index:1; min-height:574px; display:flex; align-items:center; justify-content:space-between; padding-top:92px; } .hero-copy { width:620px; } .eyebrow { display:inline-flex; align-items:center; gap:10px; height:36px; padding:0 16px; border:1px solid rgba(255,255,255,.24); border-radius:999px; background:rgba(255,255,255,.12); font-size:14px; } .eyebrow i { width:8px; height:8px; border-radius:50%; background:var(--cyan); box-shadow:0 0 0 6px rgba(56,189,248,.18); } h1 { max-width:620px; margin-top:18px !important; font-size:52px; line-height:1.18; letter-spacing:-.04em; } .lede { max-width:455px; margin-top:24px !important; font-size:17px; line-height:1.55; color:rgba(255,255,255,.92); } .hero-actions { display:flex; gap:16px; margin-top:38px; } .button { min-height:54px; padding:0 27px; border-radius:999px; } .hero-actions .primary { color:var(--blue); background:#fff; } .hero-actions .secondary { color:#fff; border-color:rgba(255,255,255,.6); background:rgba(255,255,255,.12); } .hero-actions .ghost { color:#fff; border-color:rgba(255,255,255,.42); background:rgba(255,255,255,.14); } .metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:36px; max-width:480px; } .metrics div { padding:15px; border:1px solid rgba(255,255,255,.18); border-radius:18px; background:rgba(255,255,255,.1); } .metrics strong,.metrics span { display:block; } .metrics strong { font-size:23px; } .metrics span { margin-top:3px; font-size:12px; color:rgba(255,255,255,.78); }
  .hero-visual { position:relative; width:400px; height:470px; align-self:end; } .phone { position:absolute; right:42px; bottom:0; width:242px; padding:10px; overflow:hidden; border:8px solid #14233b; border-bottom:0; border-radius:34px 34px 0 0; background:#14233b; box-shadow:0 28px 56px rgba(0,48,120,.34); } .phone img { display:block; width:100%; border-radius:20px 20px 0 0; } .orbit { position:absolute; z-index:1; padding:11px 15px; border:1px solid rgba(255,255,255,.42); border-radius:999px; background:rgba(255,255,255,.2); box-shadow:0 12px 28px rgba(0,64,157,.18); backdrop-filter:blur(10px); font-size:13px; font-weight:800; } .orbit-a { top:112px; left:10px; } .orbit-b { right:0; bottom:126px; }
  .section { padding:84px 0; } .heading { max-width:760px; margin-bottom:36px; } .heading > span { display:inline-flex; padding:5px 12px; border-radius:999px; color:var(--blue); background:#eaf4ff; font-size:13px; font-weight:800; } .heading h2 { margin-top:14px !important; font-size:40px; line-height:1.16; letter-spacing:-.035em; } .heading p { margin-top:12px !important; color:#64748b; font-size:17px; line-height:1.5; }
  .feature-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:15px; } .feature { display:grid; grid-template-columns:56px 1fr; gap:13px; align-items:center; min-height:110px; padding:16px; border:1px solid var(--line); border-radius:22px; background:rgba(255,255,255,.86); box-shadow:0 10px 24px rgba(0,87,230,.06); } .feature img { width:56px; height:56px; object-fit:contain; } .feature h3 { font-size:16px; } .feature p { margin-top:5px !important; color:#7b879d; font-size:12px; line-height:1.3; }
  .tinted { position:relative; } .tinted::before { position:absolute; z-index:0; inset:185px -42px auto; height:670px; border-radius:38px; content:""; background:linear-gradient(180deg,#edf6ff,rgba(237,246,255,0)); } .tinted > * { position:relative; z-index:1; } .demo-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:24px; } .demo { padding:22px 24px 24px; border:1px solid var(--line); border-radius:22px; background:rgba(255,255,255,.88); box-shadow:0 14px 34px rgba(0,87,230,.06); } .demo-title { display:flex; align-items:center; justify-content:space-between; gap:12px; } .demo-title h3 { font-size:21px; } .demo-title b { padding:5px 11px; border-radius:999px; color:var(--blue); background:#eaf4ff; font-size:12px; } .demo-body { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:16px; } .demo-body > img { width:100%; height:130px; border:1px solid var(--line); border-radius:17px; object-fit:cover; object-position:top; } .demo-body p { color:#506783; font-weight:700; line-height:1.45; } .demo-actions { display:flex; gap:9px; margin-top:16px; } .demo-actions a { flex:1; display:grid; height:42px; place-items:center; border-radius:999px; color:#fff; background:var(--blue); font-size:13px; font-weight:800; } .demo-actions a + a { color:var(--blue); border:1px solid var(--line); background:#fff; }
  .package-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; } .package { padding:28px 24px; border:1px solid var(--line); border-radius:24px; background:#fff; box-shadow:0 10px 30px rgba(0,87,230,.06); } .package > span,.package small { display:block; color:#7b879d; font-weight:700; } .package > strong { display:block; margin-top:15px; color:var(--blue); font-size:40px; line-height:1; } .package small { margin-top:6px; font-size:13px; } .package ul { display:grid; gap:10px; margin:20px 0 0; padding:0; list-style:none; } .package li { display:flex; gap:8px; align-items:center; font-size:14px; font-weight:600; } .package li::before { width:6px; height:6px; content:""; border-radius:50%; background:var(--blue); } .package > a { display:grid; height:44px; place-items:center; margin-top:24px; border:1px solid var(--line); border-radius:999px; color:var(--blue); font-size:14px; font-weight:800; } .package.featured { border-color:var(--blue); background:linear-gradient(180deg,#eef6ff,#fff 62%); } .package.featured > a { border-color:var(--blue); color:#fff; background:var(--blue); } .add-ons { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:20px; } .add-ons article { display:grid; gap:8px; min-height:92px; padding:17px; border:1px solid var(--line); border-radius:18px; background:#f8fbff; } .add-ons strong { font-size:14px; } .add-ons span { color:var(--blue); font-size:13px; font-weight:800; }
  .preview { width:min(calc(100% - 160px),1440px); margin-inline:auto; } .preview .heading { margin-bottom:32px; } .preview .heading h2 { font-size:44px; } .preview-grid { display:grid; grid-template-columns:minmax(0,.96fr) minmax(0,1fr); gap:32px; align-items:start; } .scene-list { display:grid; gap:12px; } .scene-image { width:100%; height:220px; border:1px solid var(--line); border-radius:22px; object-fit:contain; background:#fff; } .scene { display:grid; grid-template-columns:44px 1fr; gap:14px; align-items:center; min-height:67px; padding:10px 18px; border:1px solid #eaf2ff; border-radius:20px; background:#fff; box-shadow:0 10px 24px rgba(15,55,119,.04); } .scene.active { border-color:var(--blue); background:#eaf4ff; } .scene > img { width:44px; height:44px; object-fit:contain; } .scene strong,.scene span { display:block; } .scene strong { font-size:18px; } .scene span { margin-top:4px; color:#7b879d; font-size:14px; } .dashboard { padding:28px; border:1px solid var(--line); border-radius:26px; background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(255,255,255,.84)),radial-gradient(circle at 78% 6%,rgba(56,189,248,.3),transparent 15rem); box-shadow:0 18px 48px rgba(11,116,255,.11); } .dashboard > div:first-child { display:flex; justify-content:space-between; font-size:22px; font-weight:800; } .dashboard > div:first-child b { color:var(--blue); font-size:14px; } .dashboard > img { width:100%; height:270px; margin-top:20px; border:1px solid var(--line); border-radius:18px; object-fit:cover; object-position:top; } .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:18px; } .stats span { min-height:92px; display:grid; place-items:center; border:1px solid #eaf2ff; border-radius:16px; background:#f8fbff; color:#7b879d; text-align:center; font-size:12px; } .stats b { display:block; color:var(--ink); font-size:24px; } .dashboard > a { display:grid; height:52px; place-items:center; margin-top:20px; border-radius:999px; color:#fff; background:linear-gradient(90deg,#2dbcf1,var(--blue)); font-weight:900; }
  #pc-growth { width:min(calc(100% - 120px),1440px); padding:54px 0 44px; margin-inline:auto; } #pc-growth .heading { max-width:860px; margin-bottom:42px; } #pc-growth .heading > span { display:block; padding:0; border-radius:0; color:#0877ff; background:transparent; font-size:16px; font-weight:800; line-height:1; } #pc-growth .heading h2 { margin-top:18px !important; font-size:42px; line-height:1.2; letter-spacing:-.045em; } #pc-growth .heading p { margin-top:12px !important; color:#667995; font-size:18px; line-height:1.5; }
  .growth-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; } .growth-grid article { display:grid; align-content:start; min-height:168px; padding:22px; border:1px solid #c9dcff; border-radius:24px; background:#fff; box-shadow:0 12px 28px rgba(15,55,119,.025); } .growth-grid article:first-child { background:#f7fbff; } .growth-grid img { width:36px; height:36px; object-fit:contain; } .growth-grid strong { display:block; margin-top:14px; font-size:22px; font-weight:600; line-height:1.3; letter-spacing:-.025em; } .growth-grid span { display:block; margin-top:9px; color:#627491; font-size:16px; line-height:1.45; }
  .conversion-row { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)) minmax(420px,3.3fr); gap:14px; align-items:stretch; margin-top:28px; } .conversion-steps { display:contents; } .conversion-steps article { display:grid; min-height:96px; align-content:center; justify-items:center; gap:8px; border:1px solid #cde0ff; border-radius:20px; background:#f3f8ff; } .conversion-steps i { display:grid; width:34px; height:34px; place-items:center; border-radius:50%; color:#fff; background:#1978ee; font-size:16px; font-style:normal; font-weight:800; line-height:1; } .conversion-steps strong { color:#151a24; font-size:16px; font-weight:700; line-height:1; } .notice { display:flex; grid-column:5; gap:13px; align-items:center; min-height:96px; padding:18px 22px; margin-left:12px; border:1px solid #cde0ff; border-radius:20px; background:#f8fbff; } .notice img { flex:0 0 auto; width:30px; height:30px; object-fit:contain; } .notice p { color:#43536d; font-size:15px; font-weight:600; line-height:1.5; }
  .contact { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:28px; min-height:124px; padding:24px 30px; margin-top:30px; border-radius:32px; color:#fff; background:linear-gradient(104deg,#2ac3ed 0%,#1678ef 53%,#0e4bd8 100%); box-shadow:0 16px 32px rgba(8,99,231,.12); } .contact-copy h2 { font-size:30px; font-weight:800; line-height:1.25; letter-spacing:-.04em; } .contact-actions { position:relative; } .contact-buttons { display:flex; gap:10px; } .contact .button { min-height:48px; padding:0 17px; border-radius:999px; font-size:14px; font-weight:800; white-space:nowrap; } .contact .button img { width:21px; height:21px; object-fit:contain; } .contact-telegram,.contact-wechat,.contact-features { gap:8px; color:#fff; border-color:rgba(255,255,255,.46); background:rgba(80,158,255,.25); } .contact .contact-pricing { gap:8px; color:#0868ea; background:#fff; box-shadow:0 8px 18px rgba(0,48,153,.14); } .contact-pricing img { filter:none; } .copy-feedback { position:absolute; top:calc(100% + 7px); left:0; display:none; color:rgba(255,255,255,.95); font-size:12px; font-weight:700; white-space:nowrap; } .copy-feedback:not(:empty) { display:block; } .desktop-home footer { display:flex; justify-content:space-between; gap:24px; padding:40px 0 30px; color:#7b879d; } .desktop-home footer b { color:var(--ink); }

  @media (max-width:1180px) {
    .nav,.hero-content,.section,.desktop-home footer,.preview,.contact { width:min(calc(100% - 80px),1080px); }
    .nav { padding-inline:20px; } .nav-links { gap:16px; font-size:14px; } .nav-cta { min-width:112px; }
    .hero-copy { width:540px; } h1 { font-size:46px; } .hero-visual { width:340px; } .phone { right:24px; width:220px; }
