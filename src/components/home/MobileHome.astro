---
import { assets, demos, faqs, features, packages } from "../../data/home";
---

<div class="mobile-home" data-home-variant="mobile">
  <header class="mobile-hero" id="mobile-top">
    <nav class="mobile-nav" aria-label="移动端主导航">
      <a class="mobile-brand" href="#mobile-top"><img src={assets.brand.src} alt="" /><span>盈云购系统</span></a>
      <button class="menu-button" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-nav-dialog" data-menu-open><img src={assets.menuIcon.src} alt="" /></button>
    </nav>
    <div class="menu-dialog" id="mobile-nav-dialog" role="dialog" aria-modal="true" aria-labelledby="mobile-nav-title" hidden data-menu-dialog>
      <span class="sr-only" id="mobile-nav-title">移动端主导航</span>
      <button class="menu-close" type="button" aria-label="关闭菜单" data-menu-close>×</button>
      <nav><a href="#mobile-top" data-menu-link>首页</a><a href="#mobile-features" data-menu-link>功能展示</a><a href="#mobile-packages" data-menu-link>合作方案</a><a href="#mobile-demo" data-menu-link>演示版本</a><a href="#mobile-contact" data-menu-link>联系我们</a></nav>
    </div>
    <div class="hero-copy"><span class="eyebrow">海外云购 · 源码展示</span><h2 class="hero-title">一套完整的<br />云购展示官网</h2><p>产品页面、活动玩法、移动端视觉和咨询转化，全部以可落地的前端体验呈现。</p><a class="hero-cta" href="#mobile-demo">查看演示版本 <span>↓</span></a></div>
    <div class="hero-phone"><img src={assets.appHome.src} alt="盈云购移动端页面预览" width={assets.appHome.width} height={assets.appHome.height} loading="eager" /></div>
  </header>

  <main>
    <section class="mobile-section feature-section" id="mobile-features"><div class="section-title"><span>核心能力</span><h2>像 App 一样，快速看懂产品</h2><p>覆盖用户浏览、活动参与、运营展示与咨询转化。</p></div><div class="feature-grid">{features.map((feature) => <a class="feature" href="#mobile-demo"><img src={feature.icon.src} alt="" loading="lazy" /><span>{feature.mobileName}</span></a>)}</div></section>

    <section class="mobile-section package-section" id="mobile-packages"><div class="section-title"><span>合作方案</span><h2>有推广团队，即可免费部署</h2><p>购买我们的服务器即可上线；额外定制单独计费，技术维护运营按项目盈利的 20% 收费。</p></div><div class="package-stack">{packages.map((item) => <article class="package-card" data-package-card><div><span>{item.name}</span>{item.badge && <b>{item.badge}</b>}</div><strong>{item.price}</strong><small>{item.description}</small><ul>{item.features.map((feature) => <li>{feature}</li>)}</ul><a href="#mobile-contact">咨询合作</a></article>)}</div></section>

    <section class="mobile-section demo-section" id="mobile-demo"><div class="section-title"><span>主题演示</span><h2>选择你的品牌视觉方向</h2><p>左右滑动，查看全部主题。</p></div><div class="demo-rail" aria-label="主题演示版本">{demos.map((demo) => <article class="demo-card"><div class="demo-image"><img src={demo.image.src} alt={`${demo.name}页面预览`} loading="lazy" /><b>{demo.badge}</b></div><h3>{demo.name}</h3><p>{demo.description}</p><a href="#mobile-contact">咨询此版本</a></article>)}</div></section>

    <section class="mobile-section faq-section" id="mobile-faq"><div class="section-title"><span>常见问题</span><h2>你可能想问的</h2></div><div class="faq-stack">{faqs.map((faq) => <details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>

    <section class="quote" id="mobile-contact"><span>准备开始？</span><h2>把你的产品，做成可转化的展示页面。</h2><div class="quote-actions"><button type="button" data-copy="YunGouPro" data-feedback="mobile-copy-feedback">复制微信</button><a href="#mobile-packages">获取报价</a></div><p id="mobile-copy-feedback" aria-live="polite"></p></section>

    <section class="compliance" aria-label="合规提示"><strong>合规提示</strong><p>页面仅用于产品展示与方案介绍。实际运营前，请确认当地有关抽奖、营销活动及数据隐私的法规要求。</p></section>
  </main>
  <footer><b>盈云购系统</b><span>源码官网 / 前端展示 / 咨询转化</span></footer>
  <nav class="action-bar" aria-label="移动端快捷操作"><a href="#mobile-demo">查看演示</a><a href="#mobile-packages">合作方案</a><a href="#mobile-contact" data-copy="191064227" data-copy-label="QQ号" data-feedback="mobile-copy-feedback">复制QQ</a></nav>
</div>

<style>
  .mobile-home { --blue:#0877ff; --deep:#0057e6; --cyan:#35c9ff; --ink:#10213b; --muted:#70809a; --line:#dceaff; overflow:hidden; padding-bottom:calc(82px + env(safe-area-inset-bottom)); color:var(--ink); background:linear-gradient(180deg,#f2f8ff 0,#fff 68%); }
  .mobile-home :global(*) { box-sizing:border-box; } .mobile-home :global(h1),.mobile-home :global(h2),.mobile-home :global(h3),.mobile-home :global(p) { margin:0; } .mobile-home :global(a) { color:inherit; text-decoration:none; } .mobile-home :global(button) { font:inherit; } .mobile-home :global(:where(a,button):focus-visible) { outline:3px solid var(--cyan); outline-offset:3px; } .sr-only { position:absolute; overflow:hidden; width:1px; height:1px; padding:0; margin:-1px; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .mobile-hero { position:relative; min-height:455px; overflow:hidden; color:#fff; background:radial-gradient(circle at 100% 12%,rgba(70,220,255,.64),transparent 12rem),linear-gradient(153deg,#0b74ff 0,#0665f5 56%,#004ed9 100%); } .mobile-hero::after { position:absolute; right:-102px; bottom:-125px; width:285px; height:285px; content:""; border:1px solid rgba(255,255,255,.14); border-radius:50%; box-shadow:0 0 0 45px rgba(255,255,255,.045),0 0 0 92px rgba(255,255,255,.035); }
  .mobile-nav { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; width:calc(100% - 40px); height:66px; margin:0 auto; } .mobile-brand { display:flex; align-items:center; gap:8px; font-size:18px; font-weight:900; } .mobile-brand img { width:31px; height:31px; object-fit:contain; } .menu-button { display:grid; width:38px; height:38px; place-items:center; padding:0; border:1px solid rgba(255,255,255,.24); border-radius:12px; background:rgba(255,255,255,.1); } .menu-button img { width:21px; height:21px; filter:brightness(0) invert(1); }
  .hero-copy { position:relative; z-index:1; width:calc(100% - 40px); padding-top:31px; margin:0 auto; } .eyebrow { display:inline-flex; padding:6px 10px; border:1px solid rgba(255,255,255,.2); border-radius:999px; background:rgba(255,255,255,.1); color:rgba(255,255,255,.85); font-size:11px; font-weight:800; letter-spacing:.06em; } .hero-copy h1, .hero-copy .hero-title { margin-top:15px; font-size:34px; line-height:1.18; letter-spacing:-.055em; } .hero-copy p { max-width:250px; margin-top:13px; color:rgba(255,255,255,.82); font-size:13px; line-height:1.65; } .hero-copy .hero-cta { display:flex; width:172px; height:44px; align-items:center; justify-content:space-between; padding:0 16px; margin-top:20px; border-radius:14px; color:var(--blue); background:#fff; box-shadow:0 13px 28px rgba(0,46,150,.18); font-size:13px; font-weight:900; } .hero-cta span { font-size:17px; } .hero-phone { position:absolute; right:15px; bottom:-18px; z-index:1; width:122px; padding:5px 5px 0; overflow:hidden; border:4px solid #123d83; border-bottom:0; border-radius:19px 19px 0 0; background:#123d83; box-shadow:0 20px 34px rgba(0,42,126,.32); transform:rotate(5deg); } .hero-phone img { display:block; width:100%; border-radius:11px 11px 0 0; }
  .menu-dialog { position:fixed; z-index:20; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#fff; } .menu-dialog[hidden] { display:none; } .menu-dialog:not([hidden]) { display:flex; } .menu-dialog nav { display:grid; gap:27px; text-align:center; } .menu-dialog nav a { color:var(--ink); font-size:23px; font-weight:900; } .menu-close { position:absolute; top:17px; right:20px; display:grid; width:43px; height:43px; place-items:center; border:0; border-radius:50%; color:#667895; background:#eaf4ff; font-size:25px; }
  .mobile-section { width:calc(100% - 32px); margin:0 auto; padding:37px 0; } .section-title > span { display:inline-flex; padding:5px 10px; border-radius:999px; color:var(--blue); background:#e9f4ff; font-size:11px; font-weight:900; } .section-title h2 { margin-top:10px; font-size:24px; line-height:1.28; letter-spacing:-.04em; } .section-title p { margin-top:7px; color:var(--muted); font-size:13px; line-height:1.55; }
  .feature-section { padding-top:32px; } .feature-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:11px 8px; margin-top:21px; } .feature { display:grid; min-height:76px; place-items:center; gap:5px; padding:9px 3px; border:1px solid var(--line); border-radius:17px; background:#fff; box-shadow:0 8px 18px rgba(13,83,192,.055); font-size:11px; font-weight:800; } .feature img { width:32px; height:32px; object-fit:contain; }
  .package-section { padding-top:32px; background:linear-gradient(180deg,rgba(231,244,255,.4),transparent); } .package-stack { display:grid; gap:11px; margin-top:19px; } .package-card { display:grid; grid-template-columns:1fr auto; align-items:center; padding:16px; border:1px solid var(--line); border-radius:20px; background:#fff; box-shadow:0 12px 28px rgba(8,87,211,.06); } .package-card > div { display:flex; gap:7px; align-items:center; color:#667895; font-size:12px; font-weight:900; } .package-card > div b { padding:3px 7px; border-radius:999px; color:var(--blue); background:#e7f3ff; font-size:10px; } .package-card > strong { grid-column:1; margin-top:7px; color:var(--blue); font-size:28px; line-height:1; } .package-card > small { grid-column:1; margin-top:4px; color:var(--muted); font-size:11px; } .package-card ul { grid-column:1; display:flex; gap:10px; padding:0; margin:12px 0 0; list-style:none; color:#536782; font-size:11px; } .package-card li::before { margin-right:4px; color:var(--blue); content:"•"; } .package-card > a { grid-column:2; grid-row:1 / span 4; display:grid; width:78px; height:36px; place-items:center; border-radius:12px; color:var(--blue); background:#edf6ff; font-size:11px; font-weight:900; } .package-card.featured { border-color:#70aeff; background:linear-gradient(110deg,#edf7ff,#fff); } .package-card.featured > a { color:#fff; background:var(--blue); }
  .demo-section { width:100%; padding-inline:16px; overflow:hidden; } .demo-section .section-title { width:calc(100% - 16px); margin-left:0; } .demo-rail { display:flex; gap:13px; width:calc(100% + 16px); padding:20px 16px 6px 0; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; } .demo-rail::-webkit-scrollbar { display:none; } .demo-card { flex:0 0 232px; scroll-snap-align:start; padding:11px; border:1px solid var(--line); border-radius:20px; background:#fff; box-shadow:0 12px 28px rgba(8,87,211,.07); } .demo-image { position:relative; overflow:hidden; height:134px; border-radius:13px; background:#eaf4ff; } .demo-image img { display:block; width:100%; height:100%; object-fit:cover; object-position:top; } .demo-image b { position:absolute; top:9px; right:9px; padding:4px 8px; border-radius:999px; color:var(--blue); background:rgba(255,255,255,.9); font-size:10px; } .demo-card h3 { margin-top:12px; font-size:16px; } .demo-card p { min-height:34px; margin-top:5px; color:var(--muted); font-size:12px; line-height:1.45; } .demo-card a { display:grid; height:35px; place-items:center; margin-top:11px; border-radius:10px; color:var(--blue); background:#edf6ff; font-size:11px; font-weight:900; }
  .faq-section { padding-top:20px; } .faq-stack { display:grid; gap:9px; margin-top:16px; } .faq-item { border:1px solid var(--line); border-radius:15px; background:#fff; box-shadow:0 8px 18px rgba(13,83,192,.045); } .faq-item summary { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:13px 15px; cursor:pointer; font-size:13px; font-weight:800; list-style:none; } .faq-item summary::-webkit-details-marker { display:none; } .faq-item summary::after { flex:0 0 auto; width:19px; height:19px; content:"+"; display:grid; place-items:center; border-radius:50%; color:var(--blue); background:#e9f4ff; font-size:13px; line-height:1; transition:transform .2s; } .faq-item[open] summary::after { transform:rotate(45deg); } .faq-item p { padding:0 15px 13px; color:var(--muted); font-size:12px; line-height:1.65; }
  .quote { width:calc(100% - 32px); padding:25px 21px; margin:16px auto 0; overflow:hidden; border-radius:24px; color:#fff; background:radial-gradient(circle at 100% 0,rgba(114,229,255,.6),transparent 10rem),linear-gradient(135deg,#0e82ff,#0054dc); box-shadow:0 18px 42px rgba(0,89,230,.25); } .quote > span { color:rgba(255,255,255,.75); font-size:11px; font-weight:900; letter-spacing:.08em; } .quote h2 { max-width:275px; margin-top:9px; font-size:23px; line-height:1.3; letter-spacing:-.04em; } .quote-actions { display:grid; grid-template-columns:1fr 1fr; gap:9px; margin-top:20px; } .quote-actions a,.quote-actions button { display:grid; height:42px; place-items:center; border:1px solid rgba(255,255,255,.4); border-radius:12px; color:#fff; background:rgba(255,255,255,.1); font-size:12px; font-weight:900; } .quote-actions a { color:var(--blue); border-color:#fff; background:#fff; } .quote > p { min-height:17px; margin-top:10px; color:rgba(255,255,255,.82); font-size:11px; } .compliance { width:calc(100% - 32px); padding:22px 2px 0; margin:0 auto; color:#60718b; } .compliance strong { display:block; color:#334966; font-size:12px; } .compliance p { margin-top:7px; font-size:11px; line-height:1.6; } .mobile-home footer { display:flex; flex-direction:column; gap:5px; width:calc(100% - 32px); padding:25px 0 15px; margin:0 auto; color:#7b8ba3; font-size:11px; } .mobile-home footer b { color:var(--ink); font-size:13px; }
  .action-bar { position:fixed; z-index:10; right:12px; bottom:calc(12px + env(safe-area-inset-bottom)); left:12px; display:grid; grid-template-columns:repeat(3,1fr); gap:6px; padding:6px; border:1px solid #e1edff; border-radius:17px; background:rgba(255,255,255,.94); box-shadow:0 14px 38px rgba(15,55,119,.18); backdrop-filter:blur(15px); } .action-bar a,.action-bar button { display:grid; height:39px; place-items:center; border:0; border-radius:12px; color:var(--blue); background:transparent; font-size:11px; font-weight:900; } .action-bar a:nth-child(2) { color:#fff; background:var(--blue); }
  @media (max-width:360px) { .hero-title { font-size:31px; } .feature-grid { gap:8px 5px; } .feature { font-size:10px; } .package-card ul { gap:6px; font-size:10px; } }

  @media (min-width:861px) {
    .mobile-home { width:min(100%,640px); min-height:100vh; margin-inline:auto; box-shadow:0 0 0 1px rgba(11,116,255,.08),0 20px 70px rgba(15,55,119,.1); }
  }
</style>
