---
interface ArticleLink {
  href: string;
  title: string;
  summary: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  related?: ArticleLink[];
}

const { title, description, publishedAt, updatedAt = publishedAt, related = [] } = Astro.props;
const canonical = `https://www.yg518.com${Astro.url.pathname}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  inLanguage: "zh-CN",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  publisher: { "@type": "Organization", name: "盈云购", url: "https://www.yg518.com/" },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#0B74FF" />
    <title>{title} - 盈云购</title>

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="盈云购" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content="https://www.yg518.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="盈云购系统源码展示官网" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.yg518.com/og-image.png" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">盈云购系统</a>
      <nav aria-label="主导航">
        <a href="/#pc-features">功能展示</a>
        <a href="/#pc-demo">演示版本</a>
        <a href="/#pc-packages">价格套餐</a>
        <a href="/#pc-faq">常见问题</a>
        <a class="cta" href="/#pc-contact">咨询报价</a>
      </nav>
    </header>

    <main>
      <article>
        <header class="article-head">
          <p class="eyebrow">盈云购 · 内容指南</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <p class="meta">发布于 {publishedAt}{updatedAt !== publishedAt ? ` · 更新于 ${updatedAt}` : ""}</p>
        </header>
        <div class="content">
          <slot />
        </div>
      </article>

      {
        related.length > 0 && (
          <nav class="related" aria-label="相关文章">
            <h2>延伸阅读</h2>
            <div class="related-grid">
              {related.map((item) => (
                <a class="related-card" href={item.href}>
                  <b>{item.title}</b>
                  <p>{item.summary}</p>
                </a>
              ))}
            </div>
          </nav>
        )
      }
    </main>

    <footer class="site-footer">
      <div>
        <b>盈云购系统</b>
        <span>源码官网 / 前端展示 / 咨询转化</span>
      </div>
      <p>页面内容仅用于产品展示和方案介绍。实际业务运营前，请自行确认当地关于抽奖、积分、营销活动、数据隐私等法规要求。</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family: "PingFang SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
    --blue: #0b74ff;
    --ink: #14233b;
    --line: #e1edff;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #f3f8ff; }
  body { margin: 0; color: var(--ink); background: #f3f8ff; }

  .site-header {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 0 max(24px, calc((100% - 1080px) / 2));
    height: 64px;
    border-bottom: 1px solid rgba(225, 237, 255, 0.9);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(16px);
  }
  .brand { font-size: 17px; font-weight: 900; color: var(--ink); text-decoration: none; }
  .site-header nav { display: flex; align-items: center; gap: 6px; }
  .site-header nav a { padding: 8px 12px; border-radius: 999px; color: #47566e; font-size: 13px; font-weight: 700; text-decoration: none; }
  .site-header nav a:hover { color: var(--blue); background: #eaf4ff; }
  .site-header nav a.cta { color: #fff; background: var(--blue); }
  .site-header nav a.cta:hover { background: #0a63e0; }

  main { width: min(100% - 40px, 860px); margin: 34px auto 60px; }

  article {
    padding: 42px 48px;
    border: 1px solid rgba(225, 237, 255, 0.9);
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 18px 44px rgba(7, 83, 195, 0.07);
  }
  .article-head .eyebrow { margin: 0 0 10px; color: var(--blue); font-size: 12px; font-weight: 900; letter-spacing: 0.1em; }
  .article-head h1 { margin: 0; font-size: 32px; line-height: 1.3; letter-spacing: -0.03em; }
  .article-head .lede { margin: 14px 0 0; color: #47566e; font-size: 15px; line-height: 1.8; }
  .article-head .meta { margin: 16px 0 0; color: #8a97ad; font-size: 12px; }

  .content { margin-top: 34px; }
  .content h2 {
    margin: 34px 0 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 21px; line-height: 1.4; letter-spacing: -0.02em;
  }
  .content h2:first-child { margin-top: 0; }
  .content h3 { margin: 22px 0 8px; font-size: 16px; }
  .content p { margin: 0 0 14px; color: #334155; font-size: 15px; line-height: 1.9; }
  .content ul { margin: 0 0 16px; padding-left: 22px; color: #334155; font-size: 15px; line-height: 1.9; }
  .content li { margin-bottom: 6px; }
  .content li::marker { color: var(--blue); }
  .content strong { color: var(--ink); }
  .content a { color: var(--blue); font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(11, 116, 255, 0.35); }
  .content a:hover { border-bottom-color: var(--blue); }
  .content blockquote {
    margin: 18px 0; padding: 16px 20px;
    border-left: 4px solid var(--blue);
    border-radius: 0 14px 14px 0;
    background: #f0f7ff;
    color: #47566e; font-size: 14px; line-height: 1.8;
  }
  .content blockquote p { margin: 0; }
  .content table {
    width: 100%; margin: 16px 0 20px;
    border-collapse: collapse; font-size: 14px;
  }
  .content th, .content td { padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
  .content th { background: #f0f7ff; color: var(--ink); font-weight: 800; white-space: nowrap; }
  .content td { color: #334155; line-height: 1.6; }

  .related { margin-top: 34px; }
  .related h2 { margin: 0 0 14px; font-size: 18px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .related-card {
    display: block; padding: 18px 20px;
    border: 1px solid rgba(225, 237, 255, 0.9);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(7, 83, 195, 0.05);
    color: var(--ink); text-decoration: none;
  }
  .related-card:hover { border-color: rgba(11, 116, 255, 0.4); }
  .related-card b { display: block; font-size: 14px; line-height: 1.5; }
  .related-card p { margin: 8px 0 0; color: #64748b; font-size: 12px; line-height: 1.7; }

  .site-footer {
    display: flex; justify-content: space-between; gap: 32px;
    width: min(100% - 40px, 1080px); margin: 0 auto;
    padding: 26px 0 44px;
    color: #7b879d; font-size: 12px; line-height: 1.8;
  }
  .site-footer b { display: block; color: var(--ink); font-size: 14px; }
  .site-footer p { max-width: 560px; margin: 0; }

  @media (max-width: 760px) {
    .site-header { height: 56px; padding: 0 16px; }
    .site-header nav a { display: none; }
    .site-header nav a.cta { display: block; }
    main { width: calc(100% - 24px); margin: 18px auto 40px; }
    article { padding: 26px 22px; border-radius: 20px; }
    .article-head h1 { font-size: 24px; }
    .related-grid { grid-template-columns: 1fr; }
    .site-footer { flex-direction: column; gap: 10px; width: calc(100% - 24px); }
  }
</style>
